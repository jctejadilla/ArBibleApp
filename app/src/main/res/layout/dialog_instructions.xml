<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_translucent"
        android:padding="12dp"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="@color/primary_green" />

    <TextView
        android:id="@+id/tvInstructionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Instructions"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInstructionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Instruction text goes here."
        android:textColor="@color/text_grey"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnInstructionGotIt"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/primary_green"
        android:text="Got It!"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>