<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_meh"
    tools:context=".StudentProfile">

    <!-- Top Navigation Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_translucent"
            android:elevation="3dp"
            android:padding="10dp"
            android:src="@drawable/ic_back_arrow_curved"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1D3B2E" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#30000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="My Profile"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Profile Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Student Profile, Level Progress & Streak Header Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_streak_outer_card"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Top Profile Section -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutProfileTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_top_section"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Avatar Image -->
                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_avatar_box"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_def_avatar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Student Name -->
                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Explorer Alex!"
                        android:textColor="#1B382A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toTopOf="@+id/ivAvatar" />

                    <!-- Subtitle / Level Title -->
                    <TextView
                        android:id="@+id/tvLevelLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        android:text="Level 2 - Learner"
                        android:textColor="#527361"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toBottomOf="@+id/tvStudentName" />

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/pbXPLevel"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_xp_progress_track"
                        android:max="100"
                        android:progress="65"
                        android:progressDrawable="@drawable/bg_xp_progress_fill"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toBottomOf="@+id/tvLevelLabel" />

                    <!-- Total XP Text -->
                    <TextView
                        android:id="@+id/tvXPProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="150/250 XP"
                        android:textColor="#4A6956"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/pbXPLevel" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Bottom Streak Section -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutStreakBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_bottom_section"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/layoutProfileTop">

                    <TextView
                        android:id="@+id/tvStreakValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="6 Sunday Streak 🔥"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 2: Journey Stats Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card_white"
                android:elevation="4dp"
                android:padding="18dp"
                app:layout_constraintTop_toBottomOf="@+id/cardHeader">

                <!-- Header: Section Title -->
                <TextView
                    android:id="@+id/tvStatsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="MY JOURNEY STATS"
                    android:textColor="#1D3B2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Grid of 4 Stat Boxes (2x2) -->
                <GridLayout
                    android:id="@+id/gridStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:columnCount="2"
                    app:layout_constraintTop_toBottomOf="@+id/tvStatsTitle">

                    <!-- Stat 1: Stories Completed -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_cream_task_card"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iconStories"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_story"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvStoriesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1D3B2E"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="STORIES\nDONE"
                            android:textColor="#4A6956"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iconStories" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Stat 2: Quizzes Passed -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_cream_task_card"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iconQuiz"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_quiz"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvQuizCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="#1D3B2E"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="QUIZZES\nPASSED"
                            android:textColor="#4A6956"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iconQuiz" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Stat 3: Sundays Attended -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_cream_task_card"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iconAttendance"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_streak"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvAttendanceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6"
                            android:textColor="#1D3B2E"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="SUNDAYS\nATTENDED"
                            android:textColor="#4A6956"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iconAttendance" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Stat 4: Badges Earned -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_cream_task_card"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iconBadges"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_badges_earned"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvBadgesSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/10"
                            android:textColor="#1D3B2E"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="BADGES\nEARNED"
                            android:textColor="#4A6956"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iconBadges" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </GridLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 3: Achievements & Badges Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardAchievements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card_white"
                android:elevation="4dp"
                android:padding="18dp"
                app:layout_constraintTop_toBottomOf="@+id/cardStats">

                <!-- Header Section -->
                <TextView
                    android:id="@+id/tvAchievementsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACHIEVEMENTS:"
                    android:textColor="#1D3B2E"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvBadgesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/10 Earned"
                    android:textColor="#1D3B2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tvAchievementsTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvAchievementsTitle" />

                <!-- Attendance Badges Group -->
                <TextView
                    android:id="@+id/tvAttendanceGroupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Attendance Milestones"
                    android:textColor="#3B5C4A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvAchievementsTitle" />

                <HorizontalScrollView
                    android:id="@+id/hsvAttendanceBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@+id/tvAttendanceGroupLabel">

                    <LinearLayout
                        android:id="@+id/layoutAttendanceBadges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">

                        <include
                            android:id="@+id/badgeWorshipper"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeDisciple"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeFaithfulness"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeGodsHouse"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeSuperFaithful"
                            layout="@layout/item_badge" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Quiz Badges Group -->
                <TextView
                    android:id="@+id/tvQuizGroupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Quiz Milestones"
                    android:textColor="#3B5C4A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hsvAttendanceBadges" />

                <HorizontalScrollView
                    android:id="@+id/hsvQuizBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@+id/tvQuizGroupLabel">

                    <LinearLayout
                        android:id="@+id/layoutQuizBadges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">

                        <include
                            android:id="@+id/badgeTryer"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeLearner"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeScholar"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeExplorer"
                            layout="@layout/item_badge" />

                        <include
                            android:id="@+id/badgeChampion"
                            layout="@layout/item_badge" />

                    </LinearLayout>
                </HorizontalScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Logout Action Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_btn_yellow"
                android:elevation="3dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="#1D3B2E"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/cardAchievements" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>