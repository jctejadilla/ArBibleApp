<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_meh"
    tools:context=".AdminDashboard">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvWelcomeBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrator Portal,"
                android:textColor="#1B4235"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvWelcomeBack" />

            <!-- System Overview Card -->
            <View
                android:id="@+id/view"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:alpha="0.6"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="#FFEBEE"
                app:layout_constraintBottom_toBottomOf="@+id/tvAdminName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvWelcomeBack" />

            <ImageView
                android:id="@+id/btnLogout"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="5dp"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@+id/view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/view"
                app:layout_constraintTop_toTopOf="@+id/view"
                app:srcCompat="@drawable/ic_power_off"
                app:tint="#D32F2F" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerViewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:layout_constraintTop_toBottomOf="@+id/tvAdminName">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardSystemOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="#1B4235"
                    android:elevation="4dp"
                    android:alpha="0.8"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iconStats"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvOverviewLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/stats" />

                    <TextView
                        android:id="@+id/tvOverviewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="System Statistics"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@+id/iconStats"
                        app:layout_constraintTop_toTopOf="parent" />



                    <!-- Divider lines -->
                    <View
                        android:id="@+id/divider1"
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="#4DFFFFFF"
                        android:layout_marginTop="30dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvOverviewLabel"
                        app:layout_constraintStart_toEndOf="@+id/tvTeacherCountVal"
                        app:layout_constraintEnd_toStartOf="@+id/tvStudentCountVal" />

                    <View
                        android:id="@+id/divider2"
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="#4DFFFFFF"
                        android:layout_marginTop="30dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvOverviewLabel"
                        app:layout_constraintStart_toEndOf="@+id/tvStudentCountVal"
                        app:layout_constraintEnd_toStartOf="@+id/tvPendingProposalsVal" />

                    <ImageView
                        android:id="@+id/iconTeachers"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        app:layout_constraintEnd_toStartOf="@+id/divider1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvOverviewLabel"
                        app:srcCompat="@drawable/teacher_profile" />

                    <TextView
                        android:id="@+id/tvTeacherCountVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="..."
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/iconTeachers"
                        app:layout_constraintStart_toStartOf="@+id/iconTeachers"
                        app:layout_constraintTop_toBottomOf="@+id/iconTeachers" />

                    <TextView
                        android:id="@+id/tvTeacherLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Teachers"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@+id/iconTeachers"
                        app:layout_constraintStart_toStartOf="@+id/iconTeachers"
                        app:layout_constraintTop_toBottomOf="@+id/tvTeacherCountVal" />

                    <ImageView
                        android:id="@+id/iconStudents"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:layout_constraintEnd_toStartOf="@+id/divider2"
                        app:layout_constraintStart_toEndOf="@+id/divider1"
                        app:layout_constraintTop_toTopOf="@+id/iconTeachers"
                        app:srcCompat="@drawable/student_group" />

                    <TextView
                        android:id="@+id/tvStudentCountVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="..."
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/iconStudents"
                        app:layout_constraintStart_toStartOf="@+id/iconStudents"
                        app:layout_constraintTop_toBottomOf="@+id/iconStudents" />

                    <TextView
                        android:id="@+id/tvStudentLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Students"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@+id/iconStudents"
                        app:layout_constraintStart_toStartOf="@+id/iconStudents"
                        app:layout_constraintTop_toBottomOf="@+id/tvStudentCountVal" />

                    <ImageView
                        android:id="@+id/iconPending"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/divider2"
                        app:layout_constraintTop_toTopOf="@+id/iconTeachers"
                        app:srcCompat="@drawable/clipboard_check" />

                    <TextView
                        android:id="@+id/tvPendingProposalsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="..."
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/iconPending"
                        app:layout_constraintStart_toStartOf="@+id/iconPending"
                        app:layout_constraintTop_toBottomOf="@+id/iconPending" />

                    <TextView
                        android:id="@+id/tvPendingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Pending\nEdits"
                        android:textColor="#E0E0E0"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@+id/iconPending"
                        app:layout_constraintStart_toStartOf="@+id/iconPending"
                        app:layout_constraintTop_toBottomOf="@+id/tvPendingProposalsVal" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

                    <ImageView
                        android:id="@+id/iconAdminSettings"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_settings_gear"
                        app:tint="#124B3D"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvQuickActions"
                        app:layout_constraintBottom_toBottomOf="@+id/tvQuickActions"/>

                    <TextView
                        android:id="@+id/tvQuickActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="8dp"
                        android:text="Admin Management"
                        android:textColor="#124B3D"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@+id/iconAdminSettings"
                        app:layout_constraintTop_toBottomOf="@+id/shimmerViewContainer" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:rowCount="2"
                app:layout_constraintTop_toBottomOf="@+id/tvQuickActions">

                <!-- Monitoring Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTeacherMonitoring"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cream_task_card"
                    app:cardCornerRadius="16dp"
                    android:alpha="0.8"
                    app:cardBackgroundColor="@color/white"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:srcCompat="@drawable/student_group" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Teacher &amp; Student\nList"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Approval Queue Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardQuestionApproval"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cream_task_card"
                    app:cardBackgroundColor="@color/white"
                    android:alpha="0.8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:srcCompat="@drawable/question_approvals" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Question\nApprovals"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Analytics / Leaderboards -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLeaderboards"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cream_task_card"
                    app:cardBackgroundColor="@color/white"
                    android:alpha="0.8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:srcCompat="@drawable/leaderboard" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Leaderboards"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Approval History Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardApprovalHistory"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cream_task_card"
                    app:cardBackgroundColor="@color/white"
                    android:alpha="0.8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:srcCompat="@drawable/activity_logs" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Approval History"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>