<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".attendance_teacher_main"
    android:orientation="vertical"
    android:background="@drawable/bg_meh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/bg_circle_translucent"
            android:elevation="3dp"
            android:padding="10dp"
            android:src="@drawable/ic_back_arrow_curved"
            app:tint="#1D3B2E" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="#1B4235"/>

            <TextView
                android:id="@+id/tvDateToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunday, May 18, 2026"
                android:textColor="@color/text_grey"
                android:textSize="12sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnScanQR"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Scan QR"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B4235"
            android:paddingHorizontal="18dp"/>
    </LinearLayout>

    <!-- STATS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- PRESENT -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:background="@drawable/bg_cream_task_card"
            android:alpha="0.8"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:textColor="#2E7D32" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Present"
                    android:textColor="@color/text_grey" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ABSENT -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:background="@drawable/bg_cream_task_card"
            android:alpha="0.8"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:textColor="@color/red" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Absent"
                    android:textColor="@color/text_grey" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- RATE -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:background="@drawable/bg_cream_task_card"
            android:alpha="0.8"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:textColor="#1B4235" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rate"
                    android:textColor="@color/text_grey" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- SEARCH -->
    <EditText
        android:id="@+id/etSearchStudents"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_card_white"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:hint="Search students..."
        android:paddingHorizontal="14dp"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:inputType="text"/>

    <!-- FILTER BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:id="@+id/category">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_card"
            android:layout_weight="1"
            android:text="All (0)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B4235"/>

        <Button
            android:id="@+id/btnFilterPresent"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_card"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Present (0)"
            android:textAllCaps="false"
            android:textColor="#34A853"
            android:backgroundTint="#FFFFFF"/>

        <Button
            android:id="@+id/btnFilterAbsent"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_card"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Absent (0)"
            android:textAllCaps="false"
            android:textColor="#E53935"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

    <!-- STUDENT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingBottom="20dp"
        android:scrollbars="none" />


    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="@drawable/bg_bottom_nav_glass"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/home"
                app:tint="#73867D" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="#73867D"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStudentsTab"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/people"
                app:tint="#73867D" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Students"
                android:textColor="#73867D"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAttendanceTab"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/book_stack"
                app:tint="#1B4235" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Attendance"
                android:textColor="#1B4235"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAnalyticsTab"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/stats"
                app:tint="#73867D" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Analytics"
                android:textColor="#73867D"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
