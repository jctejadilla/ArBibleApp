<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F3F6F6">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/tvMissedQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1D4A4B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />
        <LinearLayout
            android:id="@+id/layoutReviewAnswers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your answer"
                android:textColor="#B71C1C"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvReviewSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#1D4A4B"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />
            <ImageView android:id="@+id/ivReviewSelected"
                android:layout_width="match_parent" android:layout_height="144dp"
                android:layout_marginTop="8dp" android:scaleType="fitCenter"
                android:visibility="gone" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Correct answer"
                android:textColor="#256029"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvReviewCorrect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#1D4A4B"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />
            <ImageView android:id="@+id/ivReviewCorrect"
                android:layout_width="match_parent" android:layout_height="144dp"
                android:layout_marginTop="8dp" android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>