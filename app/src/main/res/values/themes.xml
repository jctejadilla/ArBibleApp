<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ArBibleApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowAnimationStyle">@style/NoActivityAnimation</item>
    </style>

    <style name="Theme.ArBibleApp" parent="Base.Theme.ArBibleApp" />

    <style name="NoActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/no_animation</item>
    </style>

    <!-- Custom Outlined Toggle Button Style -->
    <style name="Widget.ArBibleApp.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/toggle_button_text_selector</item>
        <item name="backgroundTint">@color/toggle_button_bg_selector</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>